// Prisma schema for AWS Student Builder Group - PITS Ujjain
// Supported database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleCategory {
  Leadership
  Technical
  Operations
  Outreach
  Creative
}

enum ApplicationStatus {
  Pending
  In_Review
  Shortlisted
  Interview_Scheduled
  Accepted
  Rejected
}

enum EventCategory {
  AWS_Cloud
  AI_Machine_Learning
  Generative_AI
  Web_Development
  Hackathons
  Career_Community
}

enum EventStatus {
  upcoming
  ongoing
  past
}

model TeamMember {
  id           String       @id @default(uuid())
  name         String
  role         String
  category     RoleCategory @default(Technical)
  isLead       Boolean      @default(false)
  bio          String
  linkedinUrl  String?
  githubUrl    String?
  avatarUrl    String?
  department   String?
  year         String?
  isVacant     Boolean      @default(false)
  displayOrder Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([role])
}

model Event {
  id               String        @id @default(uuid())
  title            String
  description      String
  category         EventCategory @default(AWS_Cloud)
  date             DateTime
  time             String
  venue            String
  isOnline         Boolean       @default(false)
  status           EventStatus   @default(upcoming)
  registrationOpen Boolean       @default(true)
  registrationLink String?
  speakerName      String?
  speakerRole      String?
  tags             String[]
  capacity         Int?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([date])
  @@index([status])
}

model Project {
  id                String   @id @default(uuid())
  title             String
  description       String
  category          String
  techStack         String[]
  contributors      String[]
  githubUrl         String?
  liveDemoUrl       String?
  featured          Boolean  @default(false)
  architectureNotes String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([category])
}

model Resource {
  id            String   @id @default(uuid())
  title         String
  description   String
  category      String
  level         String   @default("Beginner")
  url           String
  type          String   @default("Official AWS")
  isOfficialAws Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
}

model CoreTeamApplication {
  id                String            @id @default(uuid())
  fullName          String
  collegeEmail      String            @unique
  personalEmail     String?
  department        String
  currentYear       String
  cgpa              Float
  technicalSkills   String
  preferredPosition String
  whyJoin           String
  projectLinks      String?
  linkedinUrl       String?
  status            ApplicationStatus @default(Pending)
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([status])
  @@index([preferredPosition])
}

model ContactSubmission {
  id         String   @id @default(uuid())
  name       String
  email      String
  subject    String
  message    String
  category   String?
  isResolved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isResolved])
}

model AdminUser {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
}
